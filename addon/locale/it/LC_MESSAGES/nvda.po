#: settings.py:84
msgid "&Alert me if a playback device becomes disabled or unavailable"
msgstr "&Avvisami se un dispositivo di riproduzione viene disabilitato o non è disponibile"

#: settings.py:61
msgid "&Number of retries (0 - infinitely):"
msgstr "&Numero di tentativi (0 - all'infinito):"

#: settings.py:89
msgid "&Prevent Windows from going to sleep automatically"
msgstr "Im&pedisci a Windows di andare automaticamente in sospensione"

#: settings.py:56
msgid "&Repeat attempts to initialize the voice synthesizer driver"
msgstr "&Ripeti i tentativi di inizializzazione del driver della sintesi vocale"

#: settings.py:79
msgid "&Unmute all playback devices, not only the default one"
msgstr "Riavvia l'audio di &tutti i dispositivi di riproduzione, non solo quello predefinito"

#: plugin.py:118
msgid "Cancelled"
msgstr "Annullato"

#: powerControl.py:168
msgid "Cannot get shutdown privilege"
msgstr "Impossibile ottenere i privilegi di spegnimento"

#: plugin.py:63
msgid "Decrease NVDA volume 5%"
msgstr "Riduci il volume di NVDA del 5%"

#: plugin.py:81
msgid "Error: Failed to change NVDA volume"
msgstr "Errore: impossibile modificare il volume di NVDA"

#: plugin.py:71
msgid "Error: No synthesizer available"
msgstr "Errore: nessuna sintesi vocale disponibile"

#: powerControl.py:172
msgid "ExitWindowsEx failed with error {error}"
msgstr "ExitWindowsEx non riuscito con l'errore {error}"

#: plugin.py:56
msgid "Increase NVDA volume 5%"
msgstr "Aumenta il volume di NVDA del 5%"

#: settings.py:50
msgid "Increase the volume if it is &lower than:"
msgstr "Aumenta il volume se è &inferiore a:"

#: settings.py:74
msgid "Play &sound when audio has been successfully turned on"
msgstr "Riproduci un &suono quando l'audio è stato attivato con successo"

#: plugin.py:113
#: plugin.py:123
msgid "Restart"
msgstr "Riavvia"

#: settings.py:38
msgid "Select the initial sound system settings that will be set when NVDA starts:"
msgstr "Seleziona le impostazioni iniziali del sistema audio da applicare all'avvio di NVDA:"

#: settings.py:44
msgid "Set &custom volume level:"
msgstr "Imposta un livello di volume &personalizzato:"

#: settings.py:31
msgid "Show countdown &confirmation dialog before shutdown or restart"
msgstr "Mostra la finestra di &conferma con conto alla rovescia prima dello spegnimento o riavvio"

#: plugin.py:96
msgid "Shut down the system (single tap) or restart it (double tap)"
msgstr "Spegni il sistema (singola pressione) o riavvialo (doppia pressione)"

#: plugin.py:113
#: plugin.py:123
msgid "Shutdown"
msgstr "Spegni"

#: settings.py:69
msgid "Switch to the default audio output &device"
msgstr "Passa al &dispositivo di uscita audio predefinito"

#: audioGuard.py:301
msgid "Warning: a sound device that was previously enabled is now unavailable or disabled. Please check Sound settings."
msgstr "Attenzione: un dispositivo audio precedentemente abilitato non è disponibile o è disabilitato. Controlla le impostazioni audio."

#: countdownDialog.py:42
msgid "{action} in {seconds}. Press any key to cancel."
msgstr "{action} in {seconds}. Premi un tasto qualsiasi per annullare."

#: countdownDialog.py:63
msgid "{seconds}..."
msgstr "{seconds}..."

