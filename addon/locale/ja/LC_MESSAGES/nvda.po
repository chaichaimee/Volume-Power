#: settings.py:84
msgid "&Alert me if a playback device becomes disabled or unavailable"
msgstr "再生デバイスが無効または利用不可になった場合にアラートを表示(&A)"

#: settings.py:61
msgid "&Number of retries (0 - infinitely):"
msgstr "リトライ回数 (0 - 無制限)(&N):"

#: settings.py:89
msgid "&Prevent Windows from going to sleep automatically"
msgstr "Windowsが自動的にスリープ状態になるのを防ぐ(&P)"

#: settings.py:56
msgid "&Repeat attempts to initialize the voice synthesizer driver"
msgstr "音声合成ドライバの初期化を再試行する(&R)"

#: settings.py:79
msgid "&Unmute all playback devices, not only the default one"
msgstr "既定のデバイスだけでなく、すべての再生デバイスのミュートを解除(&U)"

#: plugin.py:118
msgid "Cancelled"
msgstr "キャンセルされました"

#: powerControl.py:168
msgid "Cannot get shutdown privilege"
msgstr "シャットダウン権限を取得できません"

#: plugin.py:63
msgid "Decrease NVDA volume 5%"
msgstr "NVDAの音量を5%下げる"

#: plugin.py:81
msgid "Error: Failed to change NVDA volume"
msgstr "エラー: NVDAの音量変更に失敗しました"

#: plugin.py:71
msgid "Error: No synthesizer available"
msgstr "エラー: 利用可能な音声合成エンジンがありません"

#: powerControl.py:172
msgid "ExitWindowsEx failed with error {error}"
msgstr "ExitWindowsEx がエラー {error} で失敗しました"

#: plugin.py:56
msgid "Increase NVDA volume 5%"
msgstr "NVDAの音量を5%上げる"

#: settings.py:50
msgid "Increase the volume if it is &lower than:"
msgstr "音量が指定値より低い場合に上げる(&L):"

#: settings.py:74
msgid "Play &sound when audio has been successfully turned on"
msgstr "オーディオが正常にオンになったときに効果音を再生(&S)"

#: plugin.py:113
#: plugin.py:123
msgid "Restart"
msgstr "再起動"

#: settings.py:38
msgid "Select the initial sound system settings that will be set when NVDA starts:"
msgstr "NVDA起動時に設定される初期サウンドシステム設定を選択:"

#: settings.py:44
msgid "Set &custom volume level:"
msgstr "カスタム音量レベルを設定(&C):"

#: settings.py:31
msgid "Show countdown &confirmation dialog before shutdown or restart"
msgstr "シャットダウンまたは再起動の前にカウントダウン確認ダイアログを表示(&C)"

#: plugin.py:96
msgid "Shut down the system (single tap) or restart it (double tap)"
msgstr "システムをシャットダウン（1回タップ）または再起動（2回タップ）"

#: plugin.py:113
#: plugin.py:123
msgid "Shutdown"
msgstr "シャットダウン"

#: settings.py:69
msgid "Switch to the default audio output &device"
msgstr "既定のオーディオ出力デバイスに切り替える(&D)"

#: audioGuard.py:301
msgid "Warning: a sound device that was previously enabled is now unavailable or disabled. Please check Sound settings."
msgstr "警告: 以前有効だったサウンドデバイスが利用不可または無効になっています。サウンド設定を確認してください。"

#: countdownDialog.py:42
msgid "{action} in {seconds}. Press any key to cancel."
msgstr "{seconds} 秒後に {action} します。取り消すにはいずれかのキーを押してください。"

#: countdownDialog.py:63
msgid "{seconds}..."
msgstr "{seconds}..."

